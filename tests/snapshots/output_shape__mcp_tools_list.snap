          ],
          "type": "object"
        },
        "name": "semantic_search"
      },
      {
        "description": "Gives the source, the location, the complexity, the callers, and the callees of one symbol. `call_resolutions` shows the unique, ambiguous, and unresolved candidates of each call. The edges come from names, and a compiler does not prove them. The graph does not include ambiguous and unresolved calls.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "compact": {
              "default": false,
              "description": "If true, the server writes each list of flat records as a table. `table_paths` gives a JSON pointer to each table in `result`. Join the `columns` of a table with each of its `rows` to get the records. The server keeps the usual JSON when the table is not smaller.",
              "type": "boolean"
            },
            "include_source": {
              "default": true,
              "description": "If true, the result includes the source code.",
              "type": "boolean"
            },
            "limit": {
              "default": 50,
              "description": "The maximum number of items in the result. The value 0 removes the limit.",
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "max_source_lines": {
              "default": 200,
              "description": "The maximum number of source lines in the result.",
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "min_basis": {
              "default": "same_package",
              "description": "The weakest basis of a call that gives a caller or a callee. The value `name_only` adds each call whose one candidate has only the name.",
              "enum": [
                "name_only",
                "same_package",
                "imported_module",
                "qualified_path",
                "argument_type",
                "receiver_declared_type",
                "enclosing_type",
                "imported_alias",
                "imported_name",
                "same_file",
                "lexical_scope",
                "scip"
              ],
              "type": "string"
            },
            "name": {
              "description": "The symbol name. Use a bare name or the qualified form `file:name`.",
              "type": "string"
            },
            "offset": {
              "default": 0,
              "description": "The number of items to skip. Use `next_offset` from the last result.",
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "path": {
              "description": "The file or directory to analyze. The default is the repository root.",
              "type": "string"
            },
            "start_line": {
              "description": "The line on which the definition starts. Use it to select one of two definitions with the same name.",
              "maximum": 4294967295,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        "name": "get_symbol"
      },
      {
        "description": "Gives bounded context for one definition: candidate callers and callees, test and role hints, syntax uses, and a content fingerprint. The result is not a full impact analysis and not a compiler proof. `max_bytes` controls the size, thus this tool has no `limit` and no `offset`.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "depth": {
              "default": 2,
              "description": "The radius of the call graph around the definition.",
              "maximum": 4,
              "minimum": 0,
              "type": "integer"
            },
            "include_history": {
              "default": false,
              "description": "If true, the result includes files that changed together with this file in the last 30 days. These hints are not semantic dependencies.",
              "type": "boolean"
            },
            "max_bytes": {
              "default": 12000,
              "description": "The maximum size of `result` in UTF-8 bytes. The envelope is not in this budget.",
              "maximum": 1048576,
              "minimum": 1024,
              "type": "integer"
            },
            "name": {
              "description": "The symbol name. The qualified form `file:name` is best.",
              "type": "string"
            },
            "path": {
              "description": "The file or directory to analyze. The default is the repository root.",
              "type": "string"
            },
            "start_line": {
              "description": "The line on which the definition starts. Use it to select one of two definitions with the same name.",
              "maximum": 4294967295,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        "name": "task_context"
      },
      {
        "description": "Gives the possible blast radius of a symbol: its callers and callees to a given depth. The edges come from names. The tool does not include ambiguous and unresolved calls, thus the result is not a full safety check. The limit applies to the symbols of all levels.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "compact": {
              "default": false,
              "description": "If true, the server writes each list of flat records as a table. `table_paths` gives a JSON pointer to each table in `result`. Join the `columns` of a table with each of its `rows` to get the records. The server keeps the usual JSON when the table is not smaller.",
              "type": "boolean"
            },
            "depth": {
              "default": 2,
              "description": "The maximum depth of the traversal.",
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "direction": {
              "default": "both",
              "description": "The direction of the traversal.",
              "enum": [
                "callers",
                "callees",
                "both"
              ],
              "type": "string"
            },
            "limit": {
              "default": 50,
              "description": "The maximum number of items in the result. The value 0 removes the limit.",
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "min_basis": {
              "default": "same_package",
              "description": "The weakest basis of a call that gives a caller or a callee. The value `name_only` adds each call whose one candidate has only the name.",
              "enum": [
                "name_only",
                "same_package",
                "imported_module",
                "qualified_path",
                "argument_type",
                "receiver_declared_type",
                "enclosing_type",
                "imported_alias",
                "imported_name",
                "same_file",
                "lexical_scope",
                "scip"
              ],
              "type": "string"
            },
            "offset": {
              "default": 0,
              "description": "The number of items to skip. Use `next_offset` from the last result.",
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "path": {
              "description": "The file or directory to analyze. The default is the repository root.",
              "type": "string"
            },
            "symbol": {
              "description": "The symbol name. Use a bare name or the qualified form `file:name`.",
              "type": "string"
            }
          },
          "required": [
            "symbol"
          ],
          "type": "object"
        },
        "name": "impact"
      },
      {
        "description": "Finds the symbols that are most like a code snippet that you write. Write a snippet that looks like the code that you want to find.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "files": {
              "description": "The files in which to search, as paths from the root of their project. The default is all files. With `include_projects`, a path applies to each project, and a path with a `[label] ` before it, as in the `file` of a result, applies to that project.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "hypothetical_document": {
              "description": "A code snippet that looks like the code that you want to find.",
              "type": "string"
            },
            "include_projects": {
              "description": "The roots of more projects in which to search.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "limit": {
              "default": 50,
              "description": "The maximum number of items in the result. The value 0 removes the limit.",
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "max_complexity": {
              "description": "The maximum cyclomatic complexity of a result. The tool removes symbols above this value.",
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "min_score": {
              "default": 0.3,
              "description": "The minimum similarity score of a result.",
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            "offset": {
              "default": 0,
              "description": "The number of items to skip. Use `next_offset` from the last result.",
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "query": {
              "description": "The text that the result shows as its query. The default is the snippet.",
              "type": "string"
            },
            "top_k": {
              "default": 10,
              "description": "The maximum number of results. It applies after the other filters.",
              "maximum": 4294967295,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "hypothetical_document"
          ],
          "type": "object"
        },
        "name": "semantic_search_hyde"
      }
    ]
  }
