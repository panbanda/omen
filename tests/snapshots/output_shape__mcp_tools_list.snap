{
  "id": 1,
  "jsonrpc": "2.0",
  "result": {
    "tools": [
      {
        "description": "Use first. Returns top-N PageRank-ranked symbols, risks, language breakdown, directory tree, entry points, and navigation hints. Expensive on large repos; run once and cache.",
        "inputSchema": {
          "properties": {
            "compact": {
              "description": "Opt-in lossless tables. table_paths are JSON pointers into result; zip each table's columns with its rows to restore records. Falls back to normal JSON if larger.",
              "type": "boolean"
            },
            "format": {
              "description": "Output format: 'markdown' returns compact agent-facing text directly (default: json)",
              "enum": [
                "json",
                "markdown"
              ],
              "type": "string"
            },
            "limit": {
              "description": "Max items to return (default: 50, 0 = unlimited)",
              "type": "integer"
            },
            "max_risks": {
              "description": "Maximum risks to include",
              "type": "integer"
            },
            "max_symbols": {
              "description": "Maximum symbols to include",
              "type": "integer"
            },
            "max_tokens": {
              "description": "Token budget; response is trimmed to fit (default: 8000)",
              "type": "integer"
            },
            "offset": {
              "description": "Item offset for pagination (default: 0)",
              "type": "integer"
            },
            "path": {
              "description": "File or directory path",
              "type": "string"
            }
          },
          "type": "object"
        },
        "name": "context"
      },
