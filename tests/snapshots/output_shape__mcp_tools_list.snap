          ],
          "type": "object"
        },
        "name": "semantic_search"
      },
      {
        "description": "Symbol source, location, complexity and name-based callers/callees. call_resolutions exposes unique, ambiguous and unresolved candidates. Edges are not compiler-proven; ambiguous and unknown calls are excluded from the graph.",
        "inputSchema": {
          "properties": {
            "compact": {
              "description": "Opt-in lossless tables. table_paths are JSON pointers into result; zip each table's columns with its rows to restore records. Falls back to normal JSON if larger.",
              "type": "boolean"
            },
            "include_source": {
              "description": "Whether to include source code (default: true)",
              "type": "boolean"
            },
            "limit": {
              "description": "Max items to return (default: 50, 0 = unlimited)",
              "type": "integer"
            },
            "max_source_lines": {
              "description": "Maximum source lines to return (default: 200)",
              "type": "integer"
            },
            "name": {
              "description": "Symbol name to look up (bare name or qualified file:name)",
              "type": "string"
            },
            "offset": {
              "description": "Item offset for pagination (default: 0)",
              "type": "integer"
            },
            "path": {
              "description": "Repository root path",
              "type": "string"
            },
            "start_line": {
              "description": "Exact definition start line; combine with file:name to select same-file duplicates. Ambiguous queries return choices without source or graph attribution.",
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        "name": "get_symbol"
      },
      {
        "description": "Bounded context for one exact definition: candidate callers/callees, test/role convention hints, syntax uses, uncertainty, content fingerprint. Not exhaustive impact or compiler/data-flow proof. Uses a session-local content-validated index.",
        "inputSchema": {
          "properties": {
            "depth": {
              "description": "Graph radius, default 2",
              "maximum": 4,
              "minimum": 0,
              "type": "integer"
            },
            "include_history": {
              "description": "30-day co-change hints, default false; not semantic dependencies",
              "type": "boolean"
            },
            "max_bytes": {
              "description": "Hard result UTF-8 byte budget, not envelope/tokens; default 12000",
              "maximum": 1048576,
              "minimum": 1024,
              "type": "integer"
            },
            "name": {
              "description": "Symbol name, preferably file:name",
              "type": "string"
            },
            "path": {
              "description": "Repository root",
              "type": "string"
            },
            "start_line": {
              "description": "Exact definition start line",
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        "name": "task_context"
      },
      {
        "description": "Explore possible blast radius using name-based call edges and BFS. Includes input-wide resolution_summary. Ambiguous and unresolved calls are excluded, so this is not an exhaustive safety check for edits.",
        "inputSchema": {
          "properties": {
            "compact": {
              "description": "Opt-in lossless tables. table_paths are JSON pointers into result; zip each table's columns with its rows to restore records. Falls back to normal JSON if larger.",
              "type": "boolean"
            },
            "depth": {
              "description": "BFS depth for traversal (default: 2)",
              "type": "integer"
            },
            "direction": {
              "description": "Direction of traversal (default: both)",
              "enum": [
                "callers",
                "callees",
                "both"
              ],
              "type": "string"
            },
            "limit": {
              "description": "Max items to return (default: 50, 0 = unlimited)",
              "type": "integer"
            },
            "offset": {
              "description": "Item offset for pagination (default: 0)",
              "type": "integer"
            },
            "path": {
              "description": "Repository root path",
              "type": "string"
            },
            "symbol": {
              "description": "Symbol name to analyze (bare name or qualified file:name)",
              "type": "string"
            }
          },
          "required": [
            "symbol"
          ],
          "type": "object"
        },
        "name": "impact"
      },
      {
        "description": "Search using hypothetical code. Write a code snippet resembling what you want to find. This is matched against the index, producing better results than keyword queries.",
        "inputSchema": {
          "properties": {
            "files": {
              "description": "Comma-separated file paths to search within",
              "type": "string"
            },
            "hypothetical_document": {
              "description": "A code snippet resembling the code you want to find",
              "type": "string"
            },
            "include_projects": {
              "description": "Comma-separated paths to additional project roots for cross-repo search",
              "type": "string"
            },
            "limit": {
              "description": "Max items to return (default: 50, 0 = unlimited)",
              "type": "integer"
            },
            "max_complexity": {
              "description": "Exclude symbols with cyclomatic complexity above this value",
