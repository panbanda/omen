{
  "id": 1,
  "jsonrpc": "2.0",
  "result": {
    "tools": [
      {
        "description": "Use this tool first. It gives the top symbols by PageRank, the risks, the languages, the directory tree, and the entry points of the repository. The tool is slow on a large repository, thus call it one time.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "compact": {
              "default": false,
              "description": "If true, the server writes each list of flat records as a table. `table_paths` gives a JSON pointer to each table in `result`. Join the `columns` of a table with each of its `rows` to get the records. The server keeps the usual JSON when the table is not smaller.",
              "type": "boolean"
            },
            "format": {
              "default": "json",
              "description": "The output format. With `markdown`, the result is text without an envelope. `limit` and `offset` then apply to the symbols in the text.",
              "enum": [
                "json",
                "markdown"
              ],
              "type": "string"
            },
            "limit": {
              "default": 50,
              "description": "The maximum number of items in the result. The value 0 removes the limit.",
              "maximum": 4294967295,
